{
  "scene_id": "thora_b4_the_fracture",
  "start_node": "n1",
  "nodes": {
    "n1": {
      "speaker": "dana",
      "text": "“We have a problem.”",
      "next": "n2"
    },
    "n2": {
      "speaker": "thora",
      "text": "“How many?”",
      "next": "n3"
    },
    "n3": {
      "speaker": "dana",
      "text": "“You don't even know what the problem is.”",
      "next": "n4"
    },
    "n4": {
      "speaker": "thora",
      "text": "“How many people?”",
      "next": "n5"
    },
    "n5": {
      "speaker": "dana",
      "text": "“Twenty-three confirmed.”",
      "next": "n6"
    },
    "n6": {
      "speaker": "player",
      "text": "(An unstable gate has swallowed part of a temporary Gatekin shelter.)",
      "next": "n7"
    },
    "n7": {
      "speaker": "dana",
      "text": "“The structure is still anchored on this side.”",
      "next": "n8"
    },
    "n8": {
      "speaker": "faelen",
      "text": "“And the gate?”",
      "next": "n9"
    },
    "n9": {
      "speaker": "momo",
      "text": "“Collapsing inward.”",
      "next": "n10"
    },
    "n10": {
      "speaker": "thora",
      "text": "“How long?”",
      "next": "n11"
    },
    "n11": {
      "speaker": "momo",
      "text": "“Maybe nine minutes.”",
      "next": "n12"
    },
    "n12": {
      "speaker": "dana",
      "text": "“Response teams won't arrive in time.”",
      "next": "n13"
    },
    "n13": {
      "speaker": "thora",
      "text": "“Then we go.”",
      "next": "n14"
    },
    "n14": {
      "speaker": "player",
      "text": "(Inside, the shelter has become a corridor of impossible stone and half-real rooms.)",
      "next": "n15"
    },
    "n15": {
      "speaker": "player",
      "text": "(People are trapped behind a load-bearing slab threaded with gate-light.)",
      "next": "n16"
    },
    "n16": {
      "speaker": "thora",
      "text": "“I can hold it.”",
      "next": "n17"
    },
    "n17": {
      "speaker": "faelen",
      "text": "“For how long?”",
      "next": "n18"
    },
    "n18": {
      "speaker": "thora",
      "text": "“Long enough.”",
      "next": "n19"
    },
    "n19": {
      "speaker": "player",
      "text": "“What happens when the gate collapses?”",
      "next": "n20"
    },
    "n20": {
      "speaker": "thora",
      "text": "“Everyone on the safe side lives.”",
      "next": "n21"
    },
    "n21": {
      "speaker": "player",
      "text": "“That wasn't the question.”",
      "next": "n22"
    },
    "n22": {
      "speaker": "thora",
      "text": "“I know.”",
      "next": "n23"
    },
    "n23": {
      "speaker": "momo",
      "text": "“The anchor point will shear.”",
      "next": "n24"
    },
    "n24": {
      "speaker": "dana",
      "text": "“Translate.”",
      "next": "n25"
    },
    "n25": {
      "speaker": "momo",
      "text": "“Whoever is holding it stays with the wrong half.”",
      "next": "n26"
    },
    "n26": {
      "speaker": "player",
      "text": "“No.”",
      "next": "n27"
    },
    "n27": {
      "speaker": "thora",
      "text": "“There are twenty-three people.”",
      "next": "n28"
    },
    "n28": {
      "speaker": "player",
      "text": "“And one Thora.”",
      "next": "n29"
    },
    "n29": {
      "speaker": "thora",
      "text": "“Exactly.”",
      "next": "n30"
    },
    "n30": {
      "speaker": "player",
      "text": "(She says it like the arithmetic is obvious.)",
      "next": "force_cb1"
    },
    "force_cb1": {
      "speaker": "player",
      "text": "“I gave you an order.”",
      "condition": {
        "requires_flags": [
          {
            "flag": "THORA_TRIAGE",
            "equals": "force"
          }
        ]
      },
      "next": "force_cb2"
    },
    "force_cb2": {
      "speaker": "thora",
      "text": "“This is not triage.”",
      "condition": {
        "requires_flags": [
          {
            "flag": "THORA_TRIAGE",
            "equals": "force"
          }
        ]
      },
      "next": "force_cb3"
    },
    "force_cb3": {
      "speaker": "player",
      "text": "“It's exactly triage. You just keep putting yourself at zero priority.”",
      "condition": {
        "requires_flags": [
          {
            "flag": "THORA_TRIAGE",
            "equals": "force"
          }
        ]
      },
      "next": "trust_cb1"
    },
    "trust_cb1": {
      "speaker": "player",
      "text": "“I told you I trusted your triage.”",
      "condition": {
        "requires_flags": [
          {
            "flag": "THORA_TRIAGE",
            "equals": "trust"
          }
        ]
      },
      "next": "trust_cb2"
    },
    "trust_cb2": {
      "speaker": "thora",
      "text": "“Then trust it now.”",
      "condition": {
        "requires_flags": [
          {
            "flag": "THORA_TRIAGE",
            "equals": "trust"
          }
        ]
      },
      "next": "trust_cb3"
    },
    "trust_cb3": {
      "speaker": "player",
      "text": "“I trust your judgment. I don't trust the rule where you never count yourself.”",
      "condition": {
        "requires_flags": [
          {
            "flag": "THORA_TRIAGE",
            "equals": "trust"
          }
        ]
      },
      "next": "n31"
    },
    "n31": {
      "speaker": "thora",
      "text": "“I can save them.”",
      "next": "n32"
    },
    "n32": {
      "speaker": "player",
      "text": "“You can die for them.”",
      "next": "n33"
    },
    "n33": {
      "speaker": "thora",
      "text": "“If necessary.”",
      "next": "n34"
    },
    "n34": {
      "speaker": "player",
      "text": "“You keep saying that like those are the same thing.”",
      "next": "n35"
    },
    "n35": {
      "speaker": "thora",
      "text": "“Sometimes they are.”",
      "next": "n36"
    },
    "n36": {
      "speaker": "player",
      "text": "“And your life is an acceptable price?”",
      "next": "n37"
    },
    "n37": {
      "speaker": "thora",
      "text": "“Yes.”",
      "next": "n38"
    },
    "n38": {
      "speaker": "player",
      "text": "(No hesitation.)",
      "next": "n39"
    },
    "n39": {
      "speaker": "thora",
      "text": "“That is what leadership is.”",
      "next": "n40"
    },
    "n40": {
      "speaker": "faelen",
      "text": "“No.”",
      "next": "n41"
    },
    "n41": {
      "speaker": "thora",
      "text": "“Warden—”",
      "next": "n42"
    },
    "n42": {
      "speaker": "faelen",
      "text": "“That is what guilt calls leadership when it wants permission.”",
      "next": "n43"
    },
    "n43": {
      "speaker": "player",
      "text": "(Thora goes still.)",
      "choices": [
        {
          "choice_id": "stop",
          "text": "“Your life is not currency. Step back. We find another way.”",
          "next": "stop1",
          "effects": {
            "set_flags": {
              "THORA_FRACTURE": "stop"
            },
            "bond_delta": 20
          }
        },
        {
          "choice_id": "join",
          "text": "“Then nobody pays alone. We hold it together and everybody comes back.”",
          "next": "join1",
          "effects": {
            "set_flags": {
              "THORA_FRACTURE": "join"
            },
            "bond_delta": 20
          }
        },
        {
          "choice_id": "release",
          "text": "“If this is the choice you need to make... save them.”",
          "next": "rel1",
          "effects": {
            "set_flags": {
              "THORA_FRACTURE": "release"
            },
            "bond_delta": -10
          }
        }
      ]
    },
    "stop1": {
      "speaker": "thora",
      "text": "“There is no time.”",
      "next": "stop2"
    },
    "stop2": {
      "speaker": "player",
      "text": "“Momo.”",
      "next": "stop3"
    },
    "stop3": {
      "speaker": "momo",
      "text": "“The slab is tied to three smaller anchors.”",
      "next": "stop4"
    },
    "stop4": {
      "speaker": "player",
      "text": "“Kess?”",
      "next": "stop5"
    },
    "stop5": {
      "speaker": "kess",
      "text": "“I can break one.”",
      "next": "stop6"
    },
    "stop6": {
      "speaker": "faelen",
      "text": "“I can brace another.”",
      "next": "stop7"
    },
    "stop7": {
      "speaker": "player",
      "text": "“Thora.”",
      "next": "stop8"
    },
    "stop8": {
      "speaker": "thora",
      "text": "“If the timing is wrong—”",
      "next": "stop9"
    },
    "stop9": {
      "speaker": "player",
      "text": "“Then help us make it right.”",
      "next": "stop10"
    },
    "stop10": {
      "speaker": "thora",
      "text": "(She looks at the trapped people.)",
      "next": "stop11"
    },
    "stop11": {
      "speaker": "thora",
      "text": "“I hate this plan.”",
      "next": "stop12"
    },
    "stop12": {
      "speaker": "kess",
      "text": "“Great. Means it's ours.”",
      "next": "pos1"
    },
    "join1": {
      "speaker": "thora",
      "text": "“No.”",
      "next": "join2"
    },
    "join2": {
      "speaker": "player",
      "text": "“You don't get to make yourself the cheapest person in the room.”",
      "next": "join3"
    },
    "join3": {
      "speaker": "thora",
      "text": "“This is not about worth.”",
      "next": "join4"
    },
    "join4": {
      "speaker": "player",
      "text": "“Then let me help.”",
      "next": "join5"
    },
    "join5": {
      "speaker": "faelen",
      "text": "“And me.”",
      "next": "join6"
    },
    "join6": {
      "speaker": "kess",
      "text": "“And me.”",
      "next": "join7"
    },
    "join7": {
      "speaker": "momo",
      "text": "“I can call the collapse.”",
      "next": "join8"
    },
    "join8": {
      "speaker": "dana",
      "text": "“I can move civilians.”",
      "next": "join9"
    },
    "join9": {
      "speaker": "thora",
      "text": "“You will all get hurt.”",
      "next": "join10"
    },
    "join10": {
      "speaker": "player",
      "text": "“Yes.”",
      "next": "join11"
    },
    "join11": {
      "speaker": "thora",
      "text": "“That is a terrible argument.”",
      "next": "join12"
    },
    "join12": {
      "speaker": "player",
      "text": "“Still here.”",
      "next": "join13"
    },
    "join13": {
      "speaker": "thora",
      "text": "(She closes her eyes.)",
      "next": "join14"
    },
    "join14": {
      "speaker": "thora",
      "text": "“Positions.”",
      "next": "pos1"
    },
    "pos1": {
      "speaker": "player",
      "text": "(The slab rises.)",
      "next": "pos2"
    },
    "pos2": {
      "speaker": "thora",
      "text": "“Move!”",
      "next": "pos3"
    },
    "pos3": {
      "speaker": "dana",
      "text": "“First group through!”",
      "next": "pos4"
    },
    "pos4": {
      "speaker": "momo",
      "text": "“Anchor shift in six!”",
      "next": "pos5"
    },
    "pos5": {
      "speaker": "kess",
      "text": "“One down!”",
      "next": "pos6"
    },
    "pos6": {
      "speaker": "faelen",
      "text": "“Second holding!”",
      "next": "pos7"
    },
    "pos7": {
      "speaker": "player",
      "text": "(Thora's knees buckle.)",
      "next": "pos8"
    },
    "pos8": {
      "speaker": "player",
      "text": "“I've got you.”",
      "next": "pos9"
    },
    "pos9": {
      "speaker": "thora",
      "text": "“No. The beam—”",
      "next": "pos10"
    },
    "pos10": {
      "speaker": "player",
      "text": "“We've got the beam.”",
      "next": "pos11"
    },
    "pos11": {
      "speaker": "momo",
      "text": "“Three!”",
      "next": "pos12"
    },
    "pos12": {
      "speaker": "thora",
      "text": "“Last group!”",
      "next": "pos13"
    },
    "pos13": {
      "speaker": "dana",
      "text": "“Clear!”",
      "next": "pos14"
    },
    "pos14": {
      "speaker": "momo",
      "text": "“Now!”",
      "next": "pos15"
    },
    "pos15": {
      "speaker": "player",
      "text": "(Everyone lets go together.)",
      "next": "pos16"
    },
    "pos16": {
      "speaker": "player",
      "text": "(The wrong half of the shelter collapses into light.)",
      "next": "pos17"
    },
    "pos17": {
      "speaker": "player",
      "text": "(Thora lands on the safe side because Faelen physically throws her.)",
      "next": "pos18"
    },
    "pos18": {
      "speaker": "thora",
      "text": "“Warden!”",
      "next": "pos19"
    },
    "pos19": {
      "speaker": "faelen",
      "text": "“You were slow.”",
      "next": "pos20"
    },
    "pos20": {
      "speaker": "thora",
      "text": "“I am going to feed you boiled roots for a week.”",
      "next": "pos21"
    },
    "pos21": {
      "speaker": "faelen",
      "text": "“Accepted.”",
      "next": "end"
    },
    "end": {
      "end_scene": true
    },
    "rel1": {
      "speaker": "thora",
      "text": "“Thank you.”",
      "next": "rel2"
    },
    "rel2": {
      "speaker": "player",
      "text": "“Don't.”",
      "next": "rel3"
    },
    "rel3": {
      "speaker": "thora",
      "text": "“There is no kinder answer.”",
      "next": "rel4"
    },
    "rel4": {
      "speaker": "player",
      "text": "“That doesn't make it kind.”",
      "next": "rel5"
    },
    "rel5": {
      "speaker": "thora",
      "text": "“No.”",
      "next": "rel6"
    },
    "rel6": {
      "speaker": "thora",
      "text": "“But it makes it mine.”",
      "next": "rel7"
    },
    "rel7": {
      "speaker": "player",
      "text": "(She braces under the slab.)",
      "next": "rel8"
    },
    "rel8": {
      "speaker": "thora",
      "text": "“Move them.”",
      "next": "rel9"
    },
    "rel9": {
      "speaker": "player",
      "text": "(One by one, twenty-three people cross.)",
      "next": "rel10"
    },
    "rel10": {
      "speaker": "player",
      "text": "(The gate begins to fold.)",
      "next": "rel11"
    },
    "rel11": {
      "speaker": "thora",
      "text": "“Go.”",
      "next": "rel12"
    },
    "rel12": {
      "speaker": "player",
      "text": "“Thora—”",
      "next": "rel13"
    },
    "rel13": {
      "speaker": "thora",
      "text": "“Go.”",
      "next": "rel14"
    },
    "rel14": {
      "speaker": "player",
      "text": "(The last thing you see is her standing under the weight, smiling because everyone else is moving away from danger.)",
      "next": "end_release"
    },
    "end_release": {
      "end_scene": true
    }
  }
}
